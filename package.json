{
  "name": "kaan-balci-portfolio-quality-checks",
  "private": true,
  "description": "Automated preflight checks for kaanbalci.com",
  "scripts": {
    "qa": "npm run qa:data && npm run qa:i18n && npm run qa:projects && npm run qa:seo && npm run qa:runtime && npm run qa:performance && npm run qa:css && npm run qa:a11y:static && npm run qa:recruiter && npm run qa:analytics && npm run qa:automation && npm run qa:js && npm run qa:portfolio && npm run qa:assets && npm run qa:links && npm run qa:html && npm run qa:spelling",
    "qa:js": "node qa-js-syntax.js",
    "qa:portfolio": "node qa-portfolio-consistency.js",
    "qa:assets": "node qa-assets.js",
    "qa:links": "node qa-internal-links.js",
    "qa:html": "html-validate \"*.html\" \"projects/*/index.html\" \"tr/*.html\" \"tr/projects/*/index.html\" \"de/*.html\" \"de/projects/*/index.html\" \"es/*.html\" \"es/projects/*/index.html\" \"fr/*.html\" \"fr/projects/*/index.html\"",
    "qa:spelling": "cspell \"*.{html,md}\" --config cspell.json --no-progress --show-suggestions",
    "qa:audit": "node scripts/site-audit.mjs",
    "qa:ajoop": "node scripts/qa-ajoop-intents.mjs",
    "qa:ajoop:behavior": "node scripts/qa-ajoop-behavior.mjs",
    "qa:ajoop:bridge": "node scripts/qa-ajoop-bridge.mjs",
    "qa:ajoop:knowledge": "node scripts/qa-ajoop-knowledge.mjs",
    "qa:ajoop:facts": "node scripts/qa-ajoop-facts.mjs",
    "start:ajoop:bridge": "node server/ajoop-bridge.mjs",
    "qa:request": "node scripts/qa-request-submission.mjs",
    "qa:projects": "node scripts/qa-project-data.mjs",
    "qa:seo": "node scripts/qa-project-seo.mjs",
    "qa:runtime": "node scripts/qa-runtime-modules.mjs",
    "qa:performance": "node scripts/qa-performance-budget.mjs",
    "qa:css": "node scripts/qa-css-architecture.mjs",
    "qa:a11y:static": "node scripts/qa-accessibility.mjs",
    "qa:recruiter": "node scripts/qa-recruiter-ux.mjs",
    "qa:analytics": "node scripts/qa-analytics.mjs",
    "qa:automation": "node scripts/qa-portfolio-automation.mjs",
    "qa:a11y": "pa11y-ci --config .pa11yci",
    "qa:lighthouse": "lhci autorun --config=lighthouserc.json",
    "data:generate": "node scripts/generate-portfolio-data.mjs",
    "generate:projects": "node scripts/generate-project-pages.mjs",
    "qa:data": "node qa-portfolio-data.js",
    "dev:react": "vite",
    "build:react": "node scripts/prerender-react.mjs",
    "preview:react": "vite preview",
    "qa:react": "node qa-react-foundation.js",
    "qa:a11y:react": "pa11y-ci --config .pa11yci-react",
    "qa:i18n": "node scripts/qa-i18n.mjs",
    "i18n:generate": "node scripts/generate-i18n.mjs",
    "i18n:extract": "node scripts/extract-i18n-source.mjs",
    "i18n:packs": "node scripts/build-locale-packs.mjs --derive",
    "i18n:routes": "node scripts/generate-localized-routes.mjs",
    "i18n:coverage": "node scripts/build-locale-packs.mjs --coverage",
    "i18n:build": "npm run i18n:extract && npm run i18n:packs && npm run i18n:generate && npm run i18n:routes"
  },
  "devDependencies": {
    "@cspell/dict-tr-tr": "3.0.6",
    "@lhci/cli": "0.15.1",
    "@vitejs/plugin-react": "6.1.0",
    "cspell": "10.0.1",
    "html-validate": "11.6.2",
    "pa11y-ci": "4.1.1",
    "vite": "8.2.2"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  }
}
