{
  "name": "kaan-balci-portfolio-quality-checks",
  "private": true,
  "description": "Automated preflight checks for kaanbalci.com",
  "scripts": {
    "qa": "npm run qa:data && npm run qa:projects && npm run qa:js && npm run qa:portfolio && npm run qa:assets && npm run qa:links && npm run qa:html && npm run qa:spelling",
    "qa:js": "node qa-js-syntax.js",
    "qa:portfolio": "node qa-portfolio-consistency.js",
    "qa:assets": "node qa-assets.js",
    "qa:links": "node qa-internal-links.js",
    "qa:html": "html-validate \"*.html\"",
    "qa:spelling": "cspell \"*.{html,md}\" --config cspell.json --no-progress --show-suggestions",
    "qa:audit": "node scripts/site-audit.mjs",
    "qa:ajoop": "node scripts/qa-ajoop-intents.mjs",
    "qa:request": "node scripts/qa-request-submission.mjs",
    "qa:projects": "node scripts/qa-project-data.mjs",
    "qa:a11y": "pa11y-ci --config .pa11yci",
    "qa:lighthouse": "lhci autorun --config=lighthouserc.json",
    "data:generate": "node scripts/generate-portfolio-data.mjs",
    "qa:data": "node qa-portfolio-data.js",
    "dev:react": "vite",
    "build:react": "node scripts/prerender-react.mjs",
    "preview:react": "vite preview",
    "qa:react": "node qa-react-foundation.js",
    "qa:a11y:react": "pa11y-ci --config .pa11yci-react"
  },
  "devDependencies": {
    "@cspell/dict-tr-tr": "3.0.6",
    "@lhci/cli": "0.15.1",
    "@vitejs/plugin-react": "6.1.0",
    "cspell": "10.0.1",
    "html-validate": "11.6.2",
    "pa11y-ci": "4.1.1",
    "vite": "8.2.2"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  }
}
