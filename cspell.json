{
  "version": "0.2",
  "language": "en,tr,tr-TR",
  "import": [
    "@cspell/dict-tr-tr/cspell-ext.json"
  ],
  "useGitignore": true,
  "ignorePaths": [
    "assets/**",
    "node_modules/**",
    ".git/**",
    ".lighthouseci/**",
    "qa-results/**"
  ],
  "ignoreRegExpList": [
    "/https?:\\/\\/\\S+/g",
    "/mailto:\\S+/g",
    "/data:image\\/[^\\s]+/g"
