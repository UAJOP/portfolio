{
  "defaults": {
    "standard": "WCAG2AA",
    "timeout": 30000,
    "wait": 750,
    "viewport": {
      "width": 390,
      "height": 844
    },
    "useIncognitoBrowserContext": true,
    "chromeLaunchConfig": {
      "args": [
        "--no-sandbox",
        "--disable-setuid-sandbox"
      ]
    }
  },
  "urls": [
    "http://127.0.0.1:4173/",
    "http://127.0.0.1:4173/works/",
    "http://127.0.0.1:4173/games/",
    "http://127.0.0.1:4173/sinama-case-study/",
